# Leave empty for local development. The production key is injected at
# build time from the VITE_POSTHOG_KEY GitHub Actions secret on the
# canonical Shopify/gltf-compressor repository. Forks inherit no secret,
# so their builds collect nothing.
VITE_POSTHOG_KEY=

# Optional. Defaults to https://us.i.posthog.com when unset.
VITE_POSTHOG_HOST=
